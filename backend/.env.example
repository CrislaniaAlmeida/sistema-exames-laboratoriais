# Copie este arquivo para ".env" (na mesma pasta "backend") e preencha
# os valores reais. O arquivo ".env" nunca deve ser commitado no Git.

# --- Banco de dados ---
# Conexao com o banco local (desenvolvimento).
DATABASE_URL=postgresql://usuario:senha@localhost:5432/exames_db

# Conexao com o banco de producao (Neon). So usada pelos scripts de
# importacao/migracao (importar_exames.py, criar_tabela_*.py, etc.),
# nao pela aplicacao FastAPI em si.
DATABASE_URL_PRODUCAO=postgresql://usuario:senha@host-do-neon/exames_db

# --- Autenticacao ---
# Chave secreta usada para assinar os tokens JWT de login. Gere uma
# chave aleatoria longa e unica (ex: openssl rand -hex 32) e nunca
# reutilize a mesma chave entre ambientes local e producao.
SECRET_KEY=troque-por-uma-chave-secreta-aleatoria-e-longa

# --- Upload de fotos de tubo (GitHub) ---
# Token de acesso pessoal do GitHub (fine-grained, com permissao
# "Contents: Read and write" no repositorio) usado para enviar as
# fotos de tubo direto para o repositorio.
GITHUB_TOKEN=

# Repositorio e branch onde as fotos sao salvas. Os valores abaixo sao
# os defaults usados pelo codigo caso essas variaveis nao sejam
# definidas.
GITHUB_REPO=CrislaniaAlmeida/sistema-exames-laboratoriais
GITHUB_BRANCH=main
